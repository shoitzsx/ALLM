# URL da API usada pelo frontend. Deixe vazio/ausente: em produção o frontend
# chama caminhos relativos (/api/v1/...), same-origin com a própria Vercel.
# Só defina isto se quiser apontar para um backend em outro domínio.
VITE_API_URL=

# Credenciais usadas exclusivamente pelo backend (nunca use prefixo VITE_).

# Google Sheets — conta de serviço (persistência dos recebimentos)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Drive — OAuth (armazenamento dos anexos). Contas de serviço não têm
# cota de armazenamento própria para criar arquivos no Drive, por isso os
# anexos usam OAuth de uma conta Google real. Após preencher client ID/secret,
# gere o refresh token com:
#   node scripts/google-drive-oauth-setup.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opcional. Recomendado deixar vazio: com o escopo mínimo drive.file, o backend
# cria/reutiliza uma pasta própria chamada "ALM Recebimentos - Anexos".
GOOGLE_DRIVE_FOLDER_ID=

# Origens do navegador autorizadas a enviar o binário do anexo direto ao
# Google Drive (upload resumível). Lista separada por vírgula, comparação
# exata (sem wildcard, sem regex). Sem isso, toda criação de sessão de upload
# é recusada com 403 ORIGIN_NOT_ALLOWED.
DRIVE_UPLOAD_ALLOWED_ORIGINS=http://localhost:5173,https://allm.vercel.app

# Backend — opcionais (têm valor padrão se ausentes)
PORT=
HOST=
CORS_ORIGIN=

# PostgreSQL/Supabase (backend local; nunca prefixar com VITE_).
# Use a conta técnica alm_runtime_api. O modo verify-full valida certificado
# e hostname; disable é aceito somente para PostgreSQL em loopback local.
ALM_DB_HOST=
ALM_DB_PORT=5432
ALM_DB_NAME=postgres
ALM_DB_API_USER=
ALM_DB_API_PASSWORD=
ALM_DB_SSL_MODE=verify-full
# Opcional quando a CA do servidor não está no trust store do Node.
ALM_DB_SSL_CA_FILE=
