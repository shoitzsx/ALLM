# URL da API usada pelo frontend. Deixe vazio/ausente: em produção o frontend
# chama caminhos relativos (/api/v1/...), same-origin com a própria Vercel.
# Só defina isto se quiser apontar para um backend em outro domínio.
VITE_API_URL=

# Credenciais usadas exclusivamente pelo backend (nunca use prefixo VITE_).

# Google Sheets — conta de serviço (persistência dos recebimentos)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Drive — OAuth (armazenamento dos anexos). Contas de serviço não têm
# cota de armazenamento própria para criar arquivos no Drive, por isso os
# anexos usam OAuth de uma conta Google real. Gere o refresh token com:
#   node scripts/google-drive-oauth-setup.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opcional: ID de uma pasta existente no Drive. Se vazio, o backend cria/reusa
# automaticamente uma pasta chamada "ALM Recebimentos - Anexos".
GOOGLE_DRIVE_FOLDER_ID=

# Backend — opcionais (têm valor padrão se ausentes)
PORT=
HOST=
CORS_ORIGIN=
